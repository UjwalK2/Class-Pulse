# Server-side Gemini API key (recommended)
GEMINI_API_KEY=

# Storage Mode: 'json' (default local server-side database) or 'firebase' (optional cloud sync)
VITE_STORAGE_MODE=json

# Server network configuration (optional)
# PORT=3000
# LOCAL_IP=192.168.1.2 # Override auto-detected local Wi-Fi IP if needed

# Optional Firebase configuration (if VITE_STORAGE_MODE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GEMINI_API_KEY=